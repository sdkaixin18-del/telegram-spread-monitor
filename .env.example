# 从 https://my.telegram.org/apps 获取。登录时由终端询问手机号、验证码和二步验证密码。
TG_API_ID=
TG_API_HASH=

# 如果改用 Bot API，从 @BotFather 获取专用机器人的 token。
TG_BOT_TOKEN=

# 用 bot-discover 或 discover 查询，群 ID 带负号。
TG_CHAT_ID=
# 只填目标成员的用户 ID。
TG_SENDER_ID=

# 价差百分数，0.10 表示 0.10%。指定来源的开仓价差必须严格高于这个值。
MIN_SPREAD_PCT=0.10

# 两腿各自最多 3 秒、相差最多 2 秒。缩短时可配置更严的值。
MAX_QUOTE_AGE_MS=3000
MAX_QUOTE_SKEW_MS=2000
MAX_MESSAGE_AGE_SECONDS=120
HTTP_TIMEOUT_SECONDS=2
CONTRACT_CACHE_SECONDS=300

# 以下路径可选。相对路径以该 .env 文件所在目录为基准。
# TG_SESSION_PATH=.local/telegram
# STATE_DB_PATH=.local/monitor.sqlite3
